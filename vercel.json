{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/products.html/admin",
      "destination": "/admin.html",
      "permanent": false
    },
    {
      "source": "/products/admin",
      "destination": "/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bell-match-website-backend.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://bell-match-website-backend.onrender.com/uploads/:path*"
    }
  ]
}
